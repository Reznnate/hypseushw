#version 450
// Vulkan renderer: YUV 4:2:0 to RGB and the game overlay blended over it,
// with the same integer arithmetic as the CPU renderer (video.cpp) and the
// GL shader (lr_gl.cpp), so all three produce the same pixels.
// Compiled into compose.comp.inc by shaders/build.sh.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D t_y;
layout(set = 0, binding = 1) uniform sampler2D t_u;
layout(set = 0, binding = 2) uniform sampler2D t_v;
layout(set = 0, binding = 3) uniform sampler2D t_ov;
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D o_img;

layout(push_constant) uniform Params {
    ivec2 size;     // output size
    int has_video;
    int has_ov;
    ivec4 lr;       // overlay source rect: x, y, w, h
} p;

int byte_at(sampler2D t, ivec2 c) { return int(texelFetch(t, c, 0).r * 255.0 + 0.5); }

void main()
{
    const int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= p.size.x || y >= p.size.y) return;
    ivec3 c = ivec3(0);

    if (p.has_video != 0)
    {
        int l = (byte_at(t_y, ivec2(x, y)) - 16) * 76309;
        int u = byte_at(t_u, ivec2(x >> 1, y >> 1)) - 128;
        int v = byte_at(t_v, ivec2(x >> 1, y >> 1)) - 128;
        c = clamp(ivec3((l + 104597 * v) >> 16, (l - 25675 * u - 53279 * v) >> 16, (l + 132201 * u) >> 16),
                  0, 255);
    }

    if (p.has_ov != 0)
    {
        ivec2 o = ivec2(p.lr.x + (x * p.lr.z) / p.size.x, p.lr.y + (y * p.lr.w) / p.size.y);
        ivec4 q = ivec4(texelFetch(t_ov, o, 0) * 255.0 + 0.5);
        if (q.a == 255)
            c = q.rgb;
        else if (q.a != 0)
            c = (q.rgb * q.a + c * (255 - q.a)) / 255;
    }

    // image row 0 is the top in Vulkan: no flip
    imageStore(o_img, ivec2(x, y), vec4(vec3(c) / 255.0, 1.0));
}
