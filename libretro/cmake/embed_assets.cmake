#
# Generates a C source embedding every file under ASSET_ROOT/{pics,sound}, as
# the table declared in lr_assets.h.
# Usage: cmake -DASSET_ROOT=<dir> -DOUT=<file.c> -P embed_assets.cmake
file(GLOB_RECURSE files RELATIVE "${ASSET_ROOT}" "${ASSET_ROOT}/pics/*" "${ASSET_ROOT}/sound/*")
list(SORT files)

set(body "/* generated by embed_assets.cmake - do not edit */\n#include \"lr_assets.h\"\n\n")
set(table "")
set(i 0)
foreach(f ${files})
    file(READ "${ASSET_ROOT}/${f}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    if (size EQUAL 0)
        set(bytes "0") # C has no empty arrays; the table still says 0 bytes
    else()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    endif()
    string(APPEND body "static const unsigned char a${i}[] = {${bytes}};\n")
    string(APPEND table "    {\"${f}\", a${i}, ${size}},\n")
    math(EXPR i "${i} + 1")
endforeach()

string(APPEND body "\nconst struct lr_asset lr_assets[] = {\n${table}    {0, 0, 0}\n};\n")
file(WRITE "${OUT}" "${body}")
