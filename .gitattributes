# Text files are stored with LF; scripts keep LF in the working tree too, so
# they run under bash on any platform.  Windows-only scripts keep CRLF.
* text=auto
*.sh      text eol=lf
gradlew   text eol=lf
Makefile  text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.jar     binary
*.tgz     binary
*.gz      binary
*.ttf     binary
*.wav     binary
*.bmp     binary
*.spv     binary

# The vendored engine keeps upstream's bytes exactly
/core/** -text
